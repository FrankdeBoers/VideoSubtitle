<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="#1" />

    <TextView
        android:id="@+id/time_range"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="2dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toTopOf="@id/index"
        app:layout_constraintBottom_toBottomOf="@id/index"
        app:layout_constraintStart_toEndOf="@id/index"
        app:layout_constraintEnd_toStartOf="@id/cost_time"
        tools:text="00:00:01,234 → 00:00:02,500" />

    <TextView
        android:id="@+id/cost_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toTopOf="@id/index"
        app:layout_constraintBottom_toBottomOf="@id/index"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="时长 1.266" />

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/index"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Lorem ipsum dolor sit amet." />

</androidx.constraintlayout.widget.ConstraintLayout>
